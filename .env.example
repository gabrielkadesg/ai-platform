# NODE ENVIRONMENT
NODE_ENV=development

# DATABASE
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5432/ai_platform
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_platform
DATABASE_USER=ai_user
DATABASE_PASSWORD=ai_password

# BACKEND SERVER
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000

# FRONTEND
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# JWT & SECURITY
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# AI PROVIDERS
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-4-1
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# FILE UPLOAD
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,docx,txt,csv,xlsx,json,md,jpg,jpeg,png,gif,webp
FILE_STORAGE_PATH=./uploads

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX_REQUESTS=20

# SESSION & COOKIES
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=604800000

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# LOGGING
LOG_LEVEL=info
LOG_FORMAT=json

# FEATURES
ENABLE_MEMORY=true
ENABLE_PROJECTS=true
ENABLE_WEB_SEARCH=false
ENABLE_IMAGE_GENERATION=false
ENABLE_VOICE=false

# ADMIN
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!@#
