@echo off\nREM Cores para output\nsetlocal enabledelayedexpansion\n\necho.\necho =========================================\necho  ^🚀 AI Platform - Setup Automatico\necho =========================================\necho.\n\nREM 1. Verifica se Docker está instalado\necho [1/5] Verificando Docker...\nwhere docker >nul 2>nul\nif %ERRORLEVEL% NEQ 0 (\n    echo.\n    echo ❌ Docker nao esta instalado!\n    echo Baixe em: https://www.docker.com/products/docker-desktop\n    pause\n    exit /b 1\n)\necho ✓ Docker encontrado\necho.\n\nREM 2. Copia .env.example para .env se não existir\necho [2/5] Configurando ambiente...\nif not exist \".env\" (\n    if exist \".env.example\" (\n        copy .env.example .env\n        echo ✓ Arquivo .env criado\n    ) else (\n        echo. > .env\n        echo ⚠ .env.example nao encontrado, criando .env vazio\n    )\n) else (\n    echo ✓ Arquivo .env ja existe\n)\necho.\n\nREM 3. Inicia os containers\necho [3/5] Iniciando containers Docker...\ndocker-compose up -d\nif %ERRORLEVEL% NEQ 0 (\n    echo.\n    echo ❌ Erro ao iniciar containers!\n    pause\n    exit /b 1\n)\necho ✓ Containers iniciados\necho.\n\nREM 4. Aguarda o banco ficar pronto\necho [4/5] Aguardando banco de dados ficar pronto...\ntimeout /t 15 /nobreak\necho ✓ Banco pronto\necho.\n\nREM 5. Roda migrations\necho [5/5] Rodando migrations...\ndocker-compose exec -T backend npm run migrate\nif %ERRORLEVEL% NEQ 0 (\n    echo.\n    echo ⚠ Aviso: Migrations podem ter falhado\n    echo Tente rodar manualmente: docker-compose exec backend npm run migrate\n)\necho ✓ Migrations concluidas\necho.\n\nREM Seed opcional\nset /p seed=\"Deseja popular o banco com dados de teste? (s/n): \"\nif /i \"%seed%\"==\"s\" (\n    echo.\n    echo Rodando seed...\n    docker-compose exec -T backend npm run seed\n    if %ERRORLEVEL% EQU 0 (\n        echo ✓ Dados de teste adicionados\n        echo.\n        echo 📝 Login padrao:\n        echo    Email: test@example.com\n        echo    Senha: password\n    )\n)\n\necho.\necho =========================================\necho  ^✅ Setup concluido com sucesso!\necho =========================================\necho.\necho 🌐 Acesse:\necho    Frontend:  http://localhost:3000\necho    Backend:   http://localhost:5000\necho    Database:  localhost:5432\necho.\necho 📋 Comandos uteis:\necho    Ver logs:      docker-compose logs -f\necho    Parar:         docker-compose down\necho    Reiniciar:     docker-compose restart\necho.\npause\n"